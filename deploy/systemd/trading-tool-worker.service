[Unit]
Description=Trading Tool Background Data Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/trading_tool
ExecStart=/opt/trading_tool/.venv/bin/python background_worker.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=TRADING_TOOL_START_WORKER=1

[Install]
WantedBy=multi-user.target
