[Unit]
Description=Trading Tool Streamlit Web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/trading_tool
ExecStart=/opt/trading_tool/.venv/bin/streamlit run app.py --server.address 0.0.0.0 --server.port 8501
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=TRADING_TOOL_START_WORKER=0

[Install]
WantedBy=multi-user.target
